<?xml version="1.0" encoding="utf-8"?>
<!-- XLink DSP: dos curvas de crossover (pasa-bajos / pasa-altos) que se cruzan
     formando una X, con halo y brillo de tubo de neón, anillos de "link" en las puntas, una onda de
     audio que se parte en graves y agudos y el punto de corte brillando en el centro.
     Zona segura: 21..87. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Onda de audio que el crossover parte en el cruce: graves a la izquierda
         (onda larga, cian) y agudos a la derecha (onda corta, naranja). -->
    <path
        android:pathData="M12,54 q7,14 14,0 q7,-14 14,0 q7,14 14,0"
        android:strokeWidth="2.4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="12" android:startY="54"
                android:endX="54" android:endY="54">
                <item android:offset="0" android:color="#0000E5FF" />
                <item android:offset="0.55" android:color="#BF00E5FF" />
                <item android:offset="1" android:color="#CCFFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M54,54 q2.25,-9 4.5,0 q2.25,9 4.5,0 q2.25,-9 4.5,0 q2.25,9 4.5,0 q2.25,-9 4.5,0 q2.25,9 4.5,0 q2.25,-9 4.5,0 q2.25,9 4.5,0 q2.25,-9 4.5,0"
        android:strokeWidth="2.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="54"
                android:endX="94.5" android:endY="54">
                <item android:offset="0" android:color="#CCFFFFFF" />
                <item android:offset="0.45" android:color="#BFFF8A1F" />
                <item android:offset="1" android:color="#00FF3D7F" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Halos -->
    <path
        android:pathData="M33,36 C51,36 57,72 75,72"
        android:strokeColor="#6100E5FF"
        android:strokeWidth="18"
        android:strokeLineCap="round" />
    <path
        android:pathData="M33,72 C51,72 57,36 75,36"
        android:strokeColor="#61FF7A1F"
        android:strokeWidth="18"
        android:strokeLineCap="round" />

    <!-- Pasa-bajos: cian -> violeta -->
    <path
        android:pathData="M33,36 C51,36 57,72 75,72"
        android:strokeWidth="9"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="33" android:startY="36"
                android:endX="75" android:endY="72"
                android:startColor="#00E5FF"
                android:endColor="#7C4DFF" />
        </aapt:attr>
    </path>
    <!-- Brillo de tubo de neón sobre el eje del pasa-bajos (misma curva, punta a punta) -->
    <path
        android:pathData="M33,36 C51,36 57,72 75,72"
        android:strokeColor="#80FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- Pasa-altos: naranja -> rosa (pasa por encima en el cruce) -->
    <path
        android:pathData="M33,72 C51,72 57,36 75,36"
        android:strokeWidth="9"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="33" android:startY="72"
                android:endX="75" android:endY="36"
                android:startColor="#FF8A1F"
                android:endColor="#FF3D7F" />
        </aapt:attr>
    </path>
    <!-- Brillo de tubo de neón sobre el eje del pasa-altos (misma curva, punta a punta) -->
    <path
        android:pathData="M33,72 C51,72 57,36 75,36"
        android:strokeColor="#80FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

    <!-- Anillos de link -->
    <path android:strokeColor="#00E5FF" android:strokeWidth="3.5"
        android:pathData="M26,36 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />
    <path android:strokeColor="#FF8A1F" android:strokeWidth="3.5"
        android:pathData="M26,72 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />
    <path android:strokeColor="#FF3D7F" android:strokeWidth="3.5"
        android:pathData="M82,36 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />
    <path android:strokeColor="#7C4DFF" android:strokeWidth="3.5"
        android:pathData="M82,72 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />

    <!-- Punto de corte: destello blanco -->
    <path android:pathData="M44,54 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="54"
                android:gradientRadius="10"
                android:startColor="#D9FFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>
    <path android:fillColor="#FFFFFF"
        android:pathData="M50.8,54 a3.2,3.2 0 1,0 6.4,0 a3.2,3.2 0 1,0 -6.4,0" />
</vector>
