<?xml version="1.0" encoding="utf-8"?>
<!-- XLink DSP: dos curvas de crossover (pasa-bajos / pasa-altos) que se cruzan
     formando una X, con halo y brillo de tubo de neón, fichas RCA de perfil en las
     puntas, una onda de audio que se parte en graves y agudos y el punto de corte
     brillando en el centro.
     Todo va achicado al 90% para que las fichas no queden cortadas por la máscara. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group android:scaleX="0.9" android:scaleY="0.9" android:pivotX="54" android:pivotY="54">

        <!-- Onda de audio que el crossover parte en el cruce: graves a la izquierda
             (onda larga, plata) y agudos a la derecha (onda corta, roja). -->
        <path
            android:pathData="M12,54 q7,14 14,0 q7,-14 14,0 q7,14 14,0"
            android:strokeWidth="2.4"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="12" android:startY="54"
                    android:endX="54" android:endY="54">
                    <item android:offset="0" android:color="#00C3C9D1" />
                    <item android:offset="0.55" android:color="#73C3C9D1" />
                    <item android:offset="1" android:color="#80FFFFFF" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:pathData="M54,54 q2.25,-9 4.5,0 q2.25,9 4.5,0 q2.25,-9 4.5,0 q2.25,9 4.5,0 q2.25,-9 4.5,0 q2.25,9 4.5,0 q2.25,-9 4.5,0 q2.25,9 4.5,0 q2.25,-9 4.5,0"
            android:strokeWidth="2.2"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="54" android:startY="54"
                    android:endX="94.5" android:endY="54">
                    <item android:offset="0" android:color="#80FFFFFF" />
                    <item android:offset="0.45" android:color="#73FF3B1F" />
                    <item android:offset="1" android:color="#00A30D12" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Halos -->
        <path
            android:pathData="M33,36 C51,36 57,72 75,72"
            android:strokeColor="#2BC3C9D1"
            android:strokeWidth="18"
            android:strokeLineCap="round" />
        <path
            android:pathData="M33,72 C51,72 57,36 75,36"
            android:strokeColor="#2BE8202A"
            android:strokeWidth="18"
            android:strokeLineCap="round" />

        <!-- Pasa-bajos: plata que se calienta a naranja -->
        <path
            android:pathData="M33,36 C51,36 57,72 75,72"
            android:strokeWidth="9"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="33" android:startY="36"
                    android:endX="75" android:endY="72"
                    android:startColor="#C3C9D1"
                    android:endColor="#FF8A1F" />
            </aapt:attr>
        </path>
        <!-- Brillo de tubo de neón sobre el eje del pasa-bajos (misma curva, punta a punta) -->
        <path
            android:pathData="M33,36 C51,36 57,72 75,72"
            android:strokeColor="#33FFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round" />
        <!-- Pasa-altos: rojo brasa -> rojo oscuro (pasa por encima en el cruce) -->
        <path
            android:pathData="M33,72 C51,72 57,36 75,36"
            android:strokeWidth="9"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="33" android:startY="72"
                    android:endX="75" android:endY="36"
                    android:startColor="#FF3B1F"
                    android:endColor="#A30D12" />
            </aapt:attr>
        </path>
        <!-- Brillo de tubo de neón sobre el eje del pasa-altos (misma curva, punta a punta) -->
        <path
            android:pathData="M33,72 C51,72 57,36 75,36"
            android:strokeColor="#33FFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round" />

        <!-- Fichas RCA de perfil en la punta de cada cable: cuerpo del color del cable,
             aro, vaina partida y pin. Se dibujan apuntando a la derecha (u hacia afuera)
             y las de la izquierda se espejan. -->
        <group
            android:translateX="33"
            android:translateY="36"
            android:scaleX="-1">
            <path android:fillColor="#C3C9D1" android:pathData="M0.8,-5.2 H3.2 A1.8,1.8 0 0 1 5,-3.4 V3.4 A1.8,1.8 0 0 1 3.2,5.2 H0.8 A1.8,1.8 0 0 1 -1,3.4 V-3.4 A1.8,1.8 0 0 1 0.8,-5.2 Z" />
            <path android:fillColor="#CCB9BEC5" android:pathData="M5.4,-4.2 H5.8 A0.4,0.4 0 0 1 6.2,-3.8 V3.8 A0.4,0.4 0 0 1 5.8,4.2 H5.4 A0.4,0.4 0 0 1 5,3.8 V-3.8 A0.4,0.4 0 0 1 5.4,-4.2 Z" />
            <path android:pathData="M6.8,-3.4 H9.6 A0.6,0.6 0 0 1 10.2,-2.8 V2.8 A0.6,0.6 0 0 1 9.6,3.4 H6.8 A0.6,0.6 0 0 1 6.2,2.8 V-2.8 A0.6,0.6 0 0 1 6.8,-3.4 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="linear"
                        android:startX="0" android:startY="-4"
                        android:endX="0" android:endY="4">
                        <item android:offset="0" android:color="#9AA0A8" />
                        <item android:offset="0.45" android:color="#5E636A" />
                        <item android:offset="1" android:color="#2E3136" />
                    </gradient>
                </aapt:attr>
            </path>
            <path android:strokeColor="#15100F" android:strokeWidth="0.5" android:pathData="M7.6,0 H10.2" />
            <path android:fillColor="#C9CDD3" android:pathData="M11.1,-1.1 H12.3 A1.1,1.1 0 0 1 13.4,0 V0 A1.1,1.1 0 0 1 12.3,1.1 H11.1 A1.1,1.1 0 0 1 10,0 V0 A1.1,1.1 0 0 1 11.1,-1.1 Z" />
        </group>
        <group
            android:translateX="75"
            android:translateY="72">
            <path android:fillColor="#FF8A1F" android:pathData="M0.8,-5.2 H3.2 A1.8,1.8 0 0 1 5,-3.4 V3.4 A1.8,1.8 0 0 1 3.2,5.2 H0.8 A1.8,1.8 0 0 1 -1,3.4 V-3.4 A1.8,1.8 0 0 1 0.8,-5.2 Z" />
            <path android:fillColor="#CCB9BEC5" android:pathData="M5.4,-4.2 H5.8 A0.4,0.4 0 0 1 6.2,-3.8 V3.8 A0.4,0.4 0 0 1 5.8,4.2 H5.4 A0.4,0.4 0 0 1 5,3.8 V-3.8 A0.4,0.4 0 0 1 5.4,-4.2 Z" />
            <path android:pathData="M6.8,-3.4 H9.6 A0.6,0.6 0 0 1 10.2,-2.8 V2.8 A0.6,0.6 0 0 1 9.6,3.4 H6.8 A0.6,0.6 0 0 1 6.2,2.8 V-2.8 A0.6,0.6 0 0 1 6.8,-3.4 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="linear"
                        android:startX="0" android:startY="-4"
                        android:endX="0" android:endY="4">
                        <item android:offset="0" android:color="#9AA0A8" />
                        <item android:offset="0.45" android:color="#5E636A" />
                        <item android:offset="1" android:color="#2E3136" />
                    </gradient>
                </aapt:attr>
            </path>
            <path android:strokeColor="#15100F" android:strokeWidth="0.5" android:pathData="M7.6,0 H10.2" />
            <path android:fillColor="#C9CDD3" android:pathData="M11.1,-1.1 H12.3 A1.1,1.1 0 0 1 13.4,0 V0 A1.1,1.1 0 0 1 12.3,1.1 H11.1 A1.1,1.1 0 0 1 10,0 V0 A1.1,1.1 0 0 1 11.1,-1.1 Z" />
        </group>
        <group
            android:translateX="33"
            android:translateY="72"
            android:scaleX="-1">
            <path android:fillColor="#FF3B1F" android:pathData="M0.8,-5.2 H3.2 A1.8,1.8 0 0 1 5,-3.4 V3.4 A1.8,1.8 0 0 1 3.2,5.2 H0.8 A1.8,1.8 0 0 1 -1,3.4 V-3.4 A1.8,1.8 0 0 1 0.8,-5.2 Z" />
            <path android:fillColor="#CCB9BEC5" android:pathData="M5.4,-4.2 H5.8 A0.4,0.4 0 0 1 6.2,-3.8 V3.8 A0.4,0.4 0 0 1 5.8,4.2 H5.4 A0.4,0.4 0 0 1 5,3.8 V-3.8 A0.4,0.4 0 0 1 5.4,-4.2 Z" />
            <path android:pathData="M6.8,-3.4 H9.6 A0.6,0.6 0 0 1 10.2,-2.8 V2.8 A0.6,0.6 0 0 1 9.6,3.4 H6.8 A0.6,0.6 0 0 1 6.2,2.8 V-2.8 A0.6,0.6 0 0 1 6.8,-3.4 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="linear"
                        android:startX="0" android:startY="-4"
                        android:endX="0" android:endY="4">
                        <item android:offset="0" android:color="#9AA0A8" />
                        <item android:offset="0.45" android:color="#5E636A" />
                        <item android:offset="1" android:color="#2E3136" />
                    </gradient>
                </aapt:attr>
            </path>
            <path android:strokeColor="#15100F" android:strokeWidth="0.5" android:pathData="M7.6,0 H10.2" />
            <path android:fillColor="#C9CDD3" android:pathData="M11.1,-1.1 H12.3 A1.1,1.1 0 0 1 13.4,0 V0 A1.1,1.1 0 0 1 12.3,1.1 H11.1 A1.1,1.1 0 0 1 10,0 V0 A1.1,1.1 0 0 1 11.1,-1.1 Z" />
        </group>
        <group
            android:translateX="75"
            android:translateY="36">
            <path android:fillColor="#A30D12" android:pathData="M0.8,-5.2 H3.2 A1.8,1.8 0 0 1 5,-3.4 V3.4 A1.8,1.8 0 0 1 3.2,5.2 H0.8 A1.8,1.8 0 0 1 -1,3.4 V-3.4 A1.8,1.8 0 0 1 0.8,-5.2 Z" />
            <path android:fillColor="#CCB9BEC5" android:pathData="M5.4,-4.2 H5.8 A0.4,0.4 0 0 1 6.2,-3.8 V3.8 A0.4,0.4 0 0 1 5.8,4.2 H5.4 A0.4,0.4 0 0 1 5,3.8 V-3.8 A0.4,0.4 0 0 1 5.4,-4.2 Z" />
            <path android:pathData="M6.8,-3.4 H9.6 A0.6,0.6 0 0 1 10.2,-2.8 V2.8 A0.6,0.6 0 0 1 9.6,3.4 H6.8 A0.6,0.6 0 0 1 6.2,2.8 V-2.8 A0.6,0.6 0 0 1 6.8,-3.4 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="linear"
                        android:startX="0" android:startY="-4"
                        android:endX="0" android:endY="4">
                        <item android:offset="0" android:color="#9AA0A8" />
                        <item android:offset="0.45" android:color="#5E636A" />
                        <item android:offset="1" android:color="#2E3136" />
                    </gradient>
                </aapt:attr>
            </path>
            <path android:strokeColor="#15100F" android:strokeWidth="0.5" android:pathData="M7.6,0 H10.2" />
            <path android:fillColor="#C9CDD3" android:pathData="M11.1,-1.1 H12.3 A1.1,1.1 0 0 1 13.4,0 V0 A1.1,1.1 0 0 1 12.3,1.1 H11.1 A1.1,1.1 0 0 1 10,0 V0 A1.1,1.1 0 0 1 11.1,-1.1 Z" />
        </group>

        <!-- Punto de corte: destello blanco -->
        <path android:pathData="M44,54 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="54" android:centerY="54"
                    android:gradientRadius="10"
                    android:startColor="#66FFFFFF"
                    android:endColor="#00FFFFFF" />
            </aapt:attr>
        </path>
        <path android:fillColor="#FFFFFF"
            android:pathData="M50.8,54 a3.2,3.2 0 1,0 6.4,0 a3.2,3.2 0 1,0 -6.4,0" />
    </group>
</vector>
