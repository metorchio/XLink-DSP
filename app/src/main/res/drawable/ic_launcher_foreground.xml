<?xml version="1.0" encoding="utf-8"?>
<!-- XLink DSP: dos curvas de crossover (pasa-bajos / pasa-altos) que se cruzan
     formando una X, con halo neón, anillos de "link" en las puntas y el punto de
     corte marcado en el centro. Zona segura: 21..87. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Halos -->
    <path
        android:pathData="M33,36 C51,36 57,72 75,72"
        android:strokeColor="#4D00E5FF"
        android:strokeWidth="16"
        android:strokeLineCap="round" />
    <path
        android:pathData="M33,72 C51,72 57,36 75,36"
        android:strokeColor="#4DFF7A1F"
        android:strokeWidth="16"
        android:strokeLineCap="round" />

    <!-- Pasa-bajos: cian -> violeta -->
    <path
        android:pathData="M33,36 C51,36 57,72 75,72"
        android:strokeWidth="8.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="33" android:startY="36"
                android:endX="75" android:endY="72"
                android:startColor="#00E5FF"
                android:endColor="#7C4DFF" />
        </aapt:attr>
    </path>
    <!-- Pasa-altos: naranja -> rosa (pasa por encima en el cruce) -->
    <path
        android:pathData="M33,72 C51,72 57,36 75,36"
        android:strokeWidth="8.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="33" android:startY="72"
                android:endX="75" android:endY="36"
                android:startColor="#FF8A1F"
                android:endColor="#FF3D7F" />
        </aapt:attr>
    </path>

    <!-- Anillos de link -->
    <path android:strokeColor="#00E5FF" android:strokeWidth="3.5"
        android:pathData="M26,36 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />
    <path android:strokeColor="#FF8A1F" android:strokeWidth="3.5"
        android:pathData="M26,72 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />
    <path android:strokeColor="#FF3D7F" android:strokeWidth="3.5"
        android:pathData="M82,36 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />
    <path android:strokeColor="#7C4DFF" android:strokeWidth="3.5"
        android:pathData="M82,72 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />

    <!-- Punto de corte -->
    <path android:fillColor="#4DFF8A1F"
        android:pathData="M54,54 m-10,0 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0" />
    <path android:fillColor="#FF8A1F"
        android:pathData="M54,54 m-6.5,0 a6.5,6.5 0 1,0 13,0 a6.5,6.5 0 1,0 -13,0" />
    <path android:fillColor="#FFFFFF"
        android:pathData="M54,54 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" />
</vector>
