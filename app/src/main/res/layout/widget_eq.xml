<?xml version="1.0" encoding="utf-8"?>
<!-- Widget del EQ de entrada: Custom + presets (EqWidget llena textos y colores). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/app_name"
            android:textColor="#FFE8ECF4"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="#FF8A93A6"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView android:id="@+id/pill_custom" style="@style/WidgetPill" android:text="Custom" />
        <TextView android:id="@+id/pill_0" style="@style/WidgetPill" android:text="Flat" android:layout_marginStart="6dp" />
        <TextView android:id="@+id/pill_1" style="@style/WidgetPill" android:text="Bass" android:layout_marginStart="6dp" />
        <TextView android:id="@+id/pill_2" style="@style/WidgetPill" android:text="Vocal" android:layout_marginStart="6dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView android:id="@+id/pill_3" style="@style/WidgetPill" android:text="Treble" />
        <TextView android:id="@+id/pill_4" style="@style/WidgetPill" android:text="V-Shape" android:layout_marginStart="6dp" />
        <TextView android:id="@+id/pill_5" style="@style/WidgetPill" android:text="Rock" android:layout_marginStart="6dp" />
        <TextView android:id="@+id/pill_6" style="@style/WidgetPill" android:text="Jazz" android:layout_marginStart="6dp" />
    </LinearLayout>
</LinearLayout>
